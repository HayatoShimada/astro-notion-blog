---
import Layout from '../layouts/Layout.astro'
import { getNavLink } from '../lib/blog-helpers.ts'
import SocialLinks from '../components/SocialLinks.astro'
---

<Layout
  title="Services"
  description="製作条件・支援内容について"
  path="/services"
  ogImage=""
>
  <div slot="main" class="services-container">
    <section class="services-hero">
      <h1 class="services-title">Services</h1>
      <p class="services-subtitle">Probono（技術ボランティア）について</p>
    </section>

    <section class="services-content">
      <div class="service-section">
        <h2 class="section-title">Probonoとは</h2>
        <div class="service-description">
          <p>
            本活動(Foxtrot Design)は、専門スキル（主にWeb/ソフトウェア開発）を活かして、個人・団体・地域活動などの課題解決を支援する <strong>Probono（プロボノ：職能を活かした社会貢献）</strong> として行っています。
          </p>
          <p>
            営利目的の受託開発とは異なり、支援を通じて次のような価値を生むことを目的とします。
          </p>
          <ul class="service-list">
            <li>デジタル活用の機会を広げる（情報発信・業務改善・DXの入口づくり）</li>
            <li>相談者・支援者との相互学習（現場理解と技術共有）</li>
            <li>実例をもとに、知見を社会に還元する</li>
          </ul>
        </div>
      </div>

      <div class="service-section">
        <h2 class="section-title">支援できること（例）</h2>
        <div class="service-description">
          <p>
            ご相談内容や状況に応じて、無理のない範囲で支援します。
          </p>
          <ul class="service-list">
            <li>Webサイト制作（静的サイト／CMS導入など）</li>
            <li>簡易なWebアプリ・業務ツールの試作（MVP）</li>
            <li>スマホアプリの試作／技術検討</li>
            <li>既存サイトの改善提案（UI/UX・導線・表示速度など）</li>
            <li>技術相談（要件整理、技術選定、実装方針、運用の考え方）</li>
          </ul>
        </div>
      </div>

      <div class="service-section">
        <h2 class="section-title">支援できないこと（範囲外）</h2>
        <div class="service-description">
          <p>
            Probonoの性質上、以下は原則として対象外です。
          </p>
          <ul class="service-list">
            <li>サーバー費用・ドメイン・有料ツール等の費用負担</li>
            <li>成果物の性能・安全性・売上などの保証</li>
            <li>希望納期の確約（スケジュールは双方の状況で調整）</li>
            <li>緊急対応（即日復旧など）</li>
            <li>継続的な保守運用の請負（監視、定期作業、常時対応 等）</li>
          </ul>
          <p>
            ※必要に応じて「次に何をすると安全か／運用できるか」の整理や、引き継ぎに向けたドキュメント整備は相談可能です。
          </p>
        </div>
      </div>

      <div class="service-section">
        <h2 class="section-title">費用について</h2>
        <div class="service-description">
          <p>
            支援は原則として無償です（Probono）。
          </p>
          <p>
            ただし、運用に必要な外部費用（ドメイン・サーバー・各種SaaS等）はご負担いただきます。
          </p>
          <p>
            もし活動をご支援いただける場合は、任意の形で応援いただけると励みになります。
            （例：<a href="https://85-store.com" target="_blank" rel="noopener noreferrer" class="external-link">85-Store</a>での購入、SNSでの紹介、活動へのフィードバック等）
          </p>
        </div>
      </div>

      <div class="service-section">
        <h2 class="section-title">活動の公開について（ポートフォリオ・発信）</h2>
        <div class="service-description">
          <p>
            支援の過程で得られた知見や制作実績を、ポートフォリオや技術共有を目的として公開する場合があります。
          </p>
          <p>
            公開する場合は、以下を原則とします。
          </p>
          <ul class="service-list">
            <li>機密情報・個人情報・内部アカウント情報は公開しない</li>
            <li>公開に適さない内容は伏せる／抽象化する</li>
            <li>必要に応じて、事前に相談のうえ取り扱いを決める</li>
          </ul>
        </div>
      </div>

      <div class="service-section">
        <h2 class="section-title">お問い合わせ</h2>
        <div class="service-description">
          <p>
            ご相談はSNSからお気軽にご連絡ください。
          </p>
          <p>
            「何を作るべきか分からない」段階でも大丈夫です。課題の整理から一緒に考えます。
          </p>
          <div class="social-links-wrapper">
            <SocialLinks />
          </div>
          <div class="cta-center">
            <a href={getNavLink('/')} class="cta-button">ホームに戻る</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .services-container {
    max-width: 100%;
    font-family: 'Courier New', Courier, monospace;
  }

  .services-hero {
    padding: 3rem 0;
    margin-bottom: 3rem;
    text-align: center;
  }

  .services-title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 0.75rem 0;
    padding-bottom: 0.75rem;
    color: #e5e5e5;
    border-bottom: 2px solid #333;
    display: inline-block;
  }

  .services-subtitle {
    font-size: 1.1rem;
    color: #999;
    margin-top: 1rem;
  }

  .services-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .service-section {
    padding: 2rem 0;
  }

  .section-title {
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0 0 1.5rem 0;
    padding-bottom: 0.75rem;
    color: #e5e5e5;
    letter-spacing: -0.02em;
    border-bottom: 2px solid #333;
  }

  .service-description {
    font-size: 0.95rem;
    color: #999;
    line-height: 1.8;
  }

  .service-description p {
    margin: 0 0 1.5rem 0;
  }

  .service-description p:last-child {
    margin-bottom: 0;
  }

  .service-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

  .service-list li {
    padding: 0.75rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: #999;
    line-height: 1.6;
  }

  .service-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #666;
    font-weight: bold;
  }

  .important-notice {
    color: #ccc;
    font-weight: 500;
    margin-bottom: 1rem !important;
  }

  .external-link {
    color: #e5e5e5;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .external-link:hover {
    color: #fff;
  }

  .social-links-wrapper {
    margin: 1.5rem 0;
    display: flex;
    justify-content: flex-start;
  }

  .cta-center {
    text-align: center;
    margin-top: 2rem;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2rem;
    background: #404040;
    color: #e5e5e5;
    text-decoration: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .cta-button:hover {
    background: #4a4a4a;
    border-color: #666;
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .services-title {
      font-size: 1.5rem;
    }

    .section-title {
      font-size: 1.5rem;
    }

    .service-item-title {
      font-size: 1.1rem;
    }
  }
</style>

