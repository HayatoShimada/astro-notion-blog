---
import Layout from '../layouts/Layout.astro'
import { getNavLink } from '../lib/blog-helpers.ts'
import { getPosts } from '../lib/notion/client.ts'
import PostFeaturedImage from '../components/PostFeaturedImage.astro'
import PortfolioCard from '../components/PortfolioCard.astro'
import styles from '../styles/blog.module.css'

// 最新3件のブログ記事を取得
const recentPosts = await getPosts(4)

// ポートフォリオプロジェクトのデータ
const portfolioProjects = [
  {
    imagePath: '/images/85-Store.png',
    title: '85-Store',
    description: '85-Storeのショップフロント。',
    link: 'https://85-store.com/',
    tags: ['Development', 'Design', 'Next.js']
  },
  {
    imagePath: '/images/Amu-Technologies2.png',
    title: 'Amu-Technologies',
    description: 'Amu-Technologiesのコーポレートサイト。',
    link: 'https://amu-lab.com/',
    tags: ['Development', 'Next.js']
  }
]
---

<Layout title="Portfolio" description="Hayato Shimadaのポートフォリオとブログ" path="/" ogImage="">
  <div slot="main" class="portfolio-container">
    <section class="hero">
      <h1 class="hero-title">Hayato Shimada</h1>
      <p class="hero-subtitle">Developer & Designer</p>
      <p class="hero-text">
        テクノロジーとデザインの交差点で、意味のある体験を創造しています。
      </p>
    </section>

    <section class="portfolio-grid">
      <h2 class="section-title">Portfolio</h2>
      <p class="section-description">これまでに制作したデザインプロジェクトの一部をご紹介します。</p>

      <div class="cards-grid">
        {portfolioProjects.map((project) => (
          <PortfolioCard
            imagePath={project.imagePath}
            title={project.title}
            description={project.description}
            link={project.link}
            tags={project.tags}
          />
        ))}
      </div>
    </section>

    <section class="blog-section">
      <h2 class="section-title">Blog</h2>
      <p class="section-description">テクノロジー、デザイン、哲学について書いています。</p>
      
      <!-- <div class="blog-cards-grid">
        {recentPosts.length === 0 ? (
          <p class="no-posts">まだブログ記事がありません。</p>
        ) : (
          recentPosts.map((post) => (
            <div class={styles.post}>
              <PostFeaturedImage post={post} />
            </div>
          ))
        )}
      </div> -->

      <div class="cta-center">
        <a href={getNavLink('/blog')} class="cta-button">すべての記事を見る →</a>
      </div>
    </section>
  </div>

  <div slot="aside" class="portfolio-aside">
    <div class="about-section">
      <h3>About</h3>
      <p>デザインとテクノロジーの両方を愛する、クリエイティブなエンジニアです。</p>
    </div>

    <div class="contact-section">
      <h3>Contact</h3>
      <p>プロジェクトのご相談やお問い合わせはSNSよりお気軽にどうぞ。</p>
    </div>
  </div>
</Layout>

<style>
  .portfolio-container {
    max-width: 100%;
  }

  .hero {
    padding: 3rem 0;
    margin-bottom: 3rem;
    border-bottom: 1px solid #333;
  }

  .hero-title {
    font-size: 2rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
    color: #cecece;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: #999;
    margin-bottom: 1rem;
  }

  .hero-description {
    font-size: 1.1rem;
    color: #cecece;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.8;
  }

  .portfolio-grid {
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #cecece;
  }

  .section-description {
    font-size: 1rem;
    color: #999;
    margin-bottom: 2rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .blog-section {
    padding: 3rem 0;
    border-top: 1px solid #333;
  }

  .blog-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 2rem;
    margin-bottom: 3rem;
    /* グリッドアイテムのサイズを完全に制御 */
    grid-auto-rows: minmax(240px, auto);
  }

  /* Blogページと同じカードスタイルを適用 */
  .blog-cards-grid :global(.post) {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    display: block !important;
    overflow: visible !important;
  }

  /* カードの外側のコンテナを完全に固定 */
  .blog-cards-grid :global(.post) > div {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    height: 240px !important;
    position: relative !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
    display: block !important;
  }

  /* カードの画像サイズを統一 */
  .blog-cards-grid :global(.post) img,
  .blog-cards-grid :global(.post) .card-placeholder {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    height: 100% !important;
    max-height: 100% !important;
    min-height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
  }

  /* 絶対配置の要素も制御 */
  .blog-cards-grid :global(.post) [class*="absolute"] {
    position: absolute !important;
    z-index: 2 !important;
  }

  /* タイトルとテキストの幅を制限 */
  .blog-cards-grid :global(.post) h1,
  .blog-cards-grid :global(.post) p {
    max-width: 100% !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    word-wrap: break-word !important;
  }

  .no-posts {
    text-align: center;
    color: #999;
    padding: 2rem 0;
    font-size: 1.1rem;
  }

  .cta-center {
    text-align: center;
    margin-top: 2rem;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2rem;
    background: #404040;
    color: #cecece;
    text-decoration: none;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .cta-button:hover {
    background: #4a4a4a;
  }

  .portfolio-aside {
    padding: 1rem 0;
  }

  .about-section,
  .contact-section {
    margin-bottom: 2rem;
  }

  .portfolio-aside h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: #cecece;
  }

  .portfolio-aside p {
    font-size: 0.95rem;
    color: #999;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .blog-cards-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 1.2rem;
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .section-title {
      font-size: 1.5rem;
    }
  }
</style>
