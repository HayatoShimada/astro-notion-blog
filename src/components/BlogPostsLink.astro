---
import { Post } from '../lib/interfaces.ts'
import { getPostLink } from '../lib/blog-helpers.ts'
import NoContents from './NoContents.astro'

export interface Props {
  heading: string
  posts: Post[]
}

const { heading, posts } = Astro.props
---

<div class="blog-posts-link">
  <h2>{heading}</h2>
  {
    posts.length === 0 ? (
      <NoContents contents={posts} />
    ) : (
      <ul>
        {posts.map((post: Post) => (
          <li>
            <a
              href={getPostLink(post.Slug)}
              title={`${post.Icon?.Emoji || ''}${post.Title}`}
            >
              {post.Icon && post.Icon.Type === 'emoji' ? (
                <>
                  <span>{post.Icon.Emoji}</span>
                  {post.Title}
                </>
              ) : post.Icon && post.Icon.Type === 'external' ? (
                <>
                  <img
                    src={post.Icon.Url}
                    alt="Post title icon in a link list"
                  />
                  {post.Title}
                </>
              ) : (
                post.Title
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .blog-posts-link {
    margin-bottom: 2rem;
  }
  
  .blog-posts-link h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
    padding-bottom: 0.75rem;
    color: #e5e5e5;
    border-bottom: 2px solid #333;
  }
  
  .blog-posts-link ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }
  
  .blog-posts-link ul li {
    margin-bottom: 0.5rem;
  }
  
  .blog-posts-link ul li a {
    display: block;
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    line-height: 1.4;
    color: #999;
    font-size: 0.9rem;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: all 0.2s ease;
    background: transparent;
  }
  
  .blog-posts-link ul li a:hover {
    color: #e5e5e5;
    background: rgba(255, 255, 255, 0.05);
  }
  
  .blog-posts-link ul li a span,
  .blog-posts-link ul li a img {
    display: inline-block;
    margin-right: 0.4rem;
  }
  
  .blog-posts-link ul li a img {
    width: 1.1rem;
    height: 1.1rem;
    vertical-align: middle;
  }
</style>
