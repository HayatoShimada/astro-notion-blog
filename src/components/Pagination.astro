---
import { getPageLink } from '../lib/blog-helpers.ts'

export interface Props {
  currentPage: number
  numberOfPages: number
  tag?: string
}

const { currentPage, numberOfPages, tag = '' } = Astro.props

const isFirstPage = currentPage === 1
const isLastPage = currentPage === numberOfPages

const startPage = currentPage - 2 < 1 ? 1 : currentPage - 2
const endPage =
  currentPage + 2 > numberOfPages ? numberOfPages : currentPage + 2

let pages = []
for (let i = startPage; i <= endPage; i++) {
  pages.push(i)
}
---

<nav class="pagination">
  <a 
    href={getPageLink(currentPage > 1 ? currentPage - 1 : 1, tag)} 
    class={`pagination-btn ${isFirstPage ? 'inactive' : ''}`}
    aria-label="前のページ"
  >
    <svg class="pagination-icon" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
    </svg>
    Previous
  </a>

  <div class="pagination-numbers">
    {
      pages.map((p: number) => (
        <a 
          href={getPageLink(p, tag)} 
          class={`pagination-number ${p === currentPage ? 'active' : ''}`}
        >
          {p}
        </a>
      ))
    }
  </div>

  <a 
    href={getPageLink(currentPage < numberOfPages ? currentPage + 1 : numberOfPages, tag)} 
    class={`pagination-btn ${isLastPage ? 'inactive' : ''}`}
    aria-label="次のページ"
  >
    Next
    <svg class="pagination-icon" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
  </a>
</nav>

<style>
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .pagination-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: #23262f;
    color: #e5e5e5;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .pagination-btn:hover:not(.inactive) {
    background: #2a2e38;
    border-color: #444;
    transform: translateY(-2px);
  }

  .pagination-btn.inactive {
    color: #666;
    cursor: not-allowed;
    opacity: 0.4;
  }

  .pagination-icon {
    width: 1rem;
    height: 1rem;
  }

  .pagination-numbers {
    display: flex;
    gap: 0.5rem;
  }

  .pagination-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.75rem;
    background: #23262f;
    color: #999;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .pagination-number:hover {
    background: #2a2e38;
    color: #e5e5e5;
    border-color: #444;
  }

  .pagination-number.active {
    background: #404040;
    color: #e5e5e5;
    border-color: #555;
  }

  @media (max-width: 640px) {
    .pagination {
      gap: 0.5rem;
      padding: 1.5rem 0;
    }

    .pagination-btn {
      padding: 0.5rem 0.75rem;
      font-size: 0.85rem;
    }

    .pagination-btn span {
      display: none;
    }

    .pagination-icon {
      width: 1.25rem;
      height: 1.25rem;
    }

    .pagination-number {
      min-width: 2rem;
      height: 2rem;
      font-size: 0.85rem;
    }
  }
</style>
