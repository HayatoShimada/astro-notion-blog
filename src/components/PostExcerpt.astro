---
import { Post } from '../lib/interfaces.ts'
import { getPostLink } from '../lib/blog-helpers.ts'


export interface Props {
  post: Post
}

const { post } = Astro.props
---

<span class="post-excerpt">
  {post.Excerpt ? post.Excerpt : ''}
</span>

<style>
  .post-excerpt {
    display: inline;
    font-size: inherit;
    color: inherit;
  }
</style>
