---
import { Post } from '../lib/interfaces.ts'
import { filePath } from '../lib/blog-helpers'
import PostTitle from './PostTitle.astro'
import PostExcerpt from './PostExcerpt.astro'
import { getPostLink } from '../lib/blog-helpers.ts'
import PostDate from './PostDate.astro'
import PostTags from './PostTags.astro'
import ReadMoreLink from './ReadMoreLink.astro'

export interface Props {
  post: Post
}

const { post } = Astro.props

let title = post.Title

let image = '';

if (post.FeaturedImage && post.FeaturedImage.Url) {
  try {
    if (import.meta.env.DEV) {
      image = post.FeaturedImage.Url;
    } else {
      image = filePath(new URL(post.FeaturedImage.Url));
    }
  } catch (err) {
    console.log('Invalid featured image URL:', err);
  }
}

---

<div class="card-container">
  {
    image && (
      <img
        src={image}
        alt={post.Title}
        class="card-image"
      />
    )
  }
  {
    !image && (
      <div class="card-image card-placeholder"></div>
    )
  }
  <div class="absolute top-0 left-0 p-2 text-white text-xs font-semibold">
    <PostDate post={post} />
  </div>
  <div class="absolute top-0 right-0 p-2">
    <PostTags post={post} />
  </div>
  <div class="absolute inset-0 flex items-center justify-center">
    <div class="text-center px-4">
      <h1 class="text-white text-3xl font-bold">
        <PostTitle post={post} />
      </h1>
      <p class="text-white text-base mt-2">
        <PostExcerpt post={post} />
      </p>
    </div>
  </div>
</div>

<style>
  .card-container {
    position: relative;
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 100%;
    height: 240px;
    overflow: hidden;
    background-color: #2a2a2a;
  }

  .card-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.5);
    transition: filter 0.3s ease-in-out;
    z-index: 1;
  }

  .card-placeholder {
    background: linear-gradient(135deg, #404040 0%, #2a2a2a 100%);
    z-index: 1;
  }

  .card-container:hover .card-image {
    filter: brightness(1);
  }

  /* 絶対配置の要素を画像の上に表示 */
  .card-container > .absolute {
    position: absolute;
    z-index: 2;
  }
</style>
