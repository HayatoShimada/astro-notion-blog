---
import type { Post, SelectProperty } from '../lib/interfaces.ts'
import { getTagLink } from '../lib/blog-helpers.ts'
import '../styles/notion-color.css'

export interface Props {
  post: Post
  enableLink: boolean
}

const { post, enableLink = true } = Astro.props
---

<div class="post-tags">
  {
    post.Tags &&
      post.Tags.length > 0 &&
      post.Tags.map((tag: SelectProperty) => {
        if (enableLink) {
          return (
            <a href={getTagLink(tag.name)} class={`tag ${tag.color} text-white` }>
              {tag.name}
            </a>
          )
        }
        return <span class={`tag ${tag.color}`}>{tag.name}</span>
      })
  }
</div>

<style>
  .post-tags {
    font-size: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .post-tags a,
  .post-tags span {
    display: inline-block;
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    line-height: 1.2;
    background: #404040;
    color: #e5e5e5;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  
  .post-tags a:hover {
    background: #4a4a4a;
  }
</style>
